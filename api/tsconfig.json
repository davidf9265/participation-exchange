{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  // The source tree is bind-mounted into the container, and file system events do
  // not cross that boundary reliably. Polling is what makes `tsc --watch` notice
  // your edits.
  "watchOptions": {
    "watchFile": "priorityPollingInterval",
    "watchDirectory": "dynamicPriorityPolling"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
