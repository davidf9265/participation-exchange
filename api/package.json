{
  "name": "marketplace-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsc && concurrently -k -n tsc,api -c blue,green \"tsc -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "concurrently": "10.0.4",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
