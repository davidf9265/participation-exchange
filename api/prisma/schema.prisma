generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum RiskGrade {
  A
  B
  C
  D
}

enum ListingStatus {
  OPEN
  FUNDED
}

model CreditUnion {
  id            String @id
  name          String
  charterNumber String @unique
  state         String

  listings       Listing[]
  participations Participation[]
}

/// A loan participation offered for sale by a credit union.
model Listing {
  id              String        @id @default(cuid())
  reference       String        @unique
  sellerCu        CreditUnion   @relation(fields: [sellerCuId], references: [id])
  sellerCuId      String
  loanType        String
  principalAmount Decimal       @db.Decimal(14, 2)
  remainingAmount Decimal       @db.Decimal(14, 2)
  yieldRate       Decimal       @db.Decimal(6, 3)
  termMonths      Int
  riskGrade       RiskGrade
  status          ListingStatus @default(OPEN)
  originatedAt    DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  participations Participation[]

  @@index([riskGrade])
  @@index([status])
}

/// A slice of a listing bought by a credit union.
/// Immutable by convention (spec section 7): the application never updates or
/// deletes a Participation. A correction is a new row, not an edit.
model Participation {
  id          String      @id @default(cuid())
  listing     Listing     @relation(fields: [listingId], references: [id])
  listingId   String
  buyerCu     CreditUnion @relation(fields: [buyerCuId], references: [id])
  buyerCuId   String
  amount      Decimal     @db.Decimal(14, 2)
  /// Snapshot of the listing's yield and term at purchase time (spec section 7, option 2).
  yieldRate   Decimal     @db.Decimal(6, 3)
  termMonths  Int
  purchasedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  /// Client-generated key for the purchase attempt (see 3.4 of the spec).
  idempotencyKey String

  @@unique([buyerCuId, idempotencyKey])
  @@index([buyerCuId])
  @@index([listingId])
}
