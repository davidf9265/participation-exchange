# Postgres
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace

# API -> Postgres (host `db` is the compose service name)
DATABASE_URL=postgresql://marketplace:marketplace@db:5432/marketplace

# Browser -> API. Read by the browser, so it must be the host-side URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Host port for Postgres. Change it if 5432 is already taken on your machine;
# the app itself reaches the database over the compose network, not this port.
DB_PORT=5432
